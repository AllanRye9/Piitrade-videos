{
  "name": "piitrade-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run src && npm run test:logic",
    "test:logic": "node --experimental-strip-types --test test/productLogic.test.mjs test/productChips.test.mjs test/apiBase.test.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.42.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.0",
    "vite": "^5.4.8",
    "vitest": "^2.1.9"
  },
  "browserslist": [
    "defaults",
    "not IE 11",
    "iOS >= 12",
    "Safari >= 12",
    "Android >= 6"
  ]
}

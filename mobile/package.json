{
  "name": "piitrade-videos-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.0",
    "expo": "~57.0.34",
    "expo-build-properties": "~57.0.24",
    "expo-constants": "~57.0.25",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.22",
    "expo-document-picker": "~57.0.3",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.22",
    "expo-linking": "~57.0.14",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.12",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-video": "~57.0.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.1"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src && npm run test:logic",
    "prebuild:android": "expo prebuild --platform android --no-install",
    "apk": "expo prebuild --platform android --no-install --clean && cd android && ./gradlew assembleRelease",
    "apk:fast": "expo prebuild --platform android --no-install --clean && cd android && ./gradlew assembleRelease --build-cache -PreactNativeArchitectures=arm64-v8a",
    "test:logic": "node --experimental-strip-types --test test/productLogic.test.mjs test/net.test.mjs test/eventQueue.test.mjs test/uploadFailure.test.mjs"
  },
  "private": true
}

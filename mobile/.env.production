# Copy to .env — Expo inlines EXPO_PUBLIC_* values into the app at build time.
# The app talks to v.piitrade.com (the API at /api and uploaded media at /uploads). The website, share links
# (/v/<id>) and legal pages live on videos.piitrade.com.
# Give the bare origin (no trailing slash, no /api). If this is unset, or still names the old yotweek host,
# the app falls back to https://v.piitrade.com.
EXPO_PUBLIC_API_BASE_URL=https://v.piitrade.com
# Website used for share links, legal pages and password-reset emails (defaults to the API URL)
# EXPO_PUBLIC_WEB_URL=https://videos.piitrade.com
# EXPO_PUBLIC_PIITRADE_SITE_URL=https://piitrade.com

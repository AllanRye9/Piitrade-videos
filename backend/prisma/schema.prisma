generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Video {
  id             String   @id @default(cuid())
  title          String
  description    String   @default("")
  filename       String
  posterFilename String?
  mimeType       String
  size           Int
  duration       Float?
  likes          Int      @default(0)
  views          Int      @default(0)
  comments       Int      @default(0)
  createdAt      DateTime @default(now())
  // The anonymous session (same X-Session-Id used everywhere else)
  // that uploaded this video — nullable so pre-existing/seeded videos
  // with no known uploader remain valid. Lets an uploader's videos be
  // browsed together on a public creator page (see routes/creators.ts)
  // without requiring real accounts/authentication.
  uploaderSessionId String?

  commentList    Comment[]
  states         UserVideoState[]

  @@index([createdAt])
  @@index([uploaderSessionId])
}

model Comment {
  id        String   @id @default(cuid())
  videoId   String
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  author    String   @default("Guest")
  text      String
  createdAt DateTime @default(now())

  @@index([videoId])
}

// Per-browser-session like/favorite/save state, keyed by an anonymous
// session id the frontend generates and stores in localStorage.
// This avoids requiring a login system while still persisting state.
model UserVideoState {
  id        String  @id @default(cuid())
  sessionId String
  videoId   String
  video     Video   @relation(fields: [videoId], references: [id], onDelete: Cascade)
  liked     Boolean @default(false)
  favorited Boolean @default(false)
  saved     Boolean @default(false)

  @@unique([sessionId, videoId])
  @@index([videoId])
}

// Product catalog used by visual search. `phash` is a 64-bit perceptual
// hash (as hex) computed once at seed/creation time and compared against
// the hash of the user's cropped selection using Hamming distance.
model Product {
  id            String @id @default(cuid())
  name          String
  price         String
  category      String
  imageFilename String
  phash         String
}

// Admin accounts for the /admin dashboard. This app has no public user
// accounts — regular visitors interact anonymously via a per-browser
// session id (see UserVideoState). Only admins log in.
model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

// Per anonymous-browser-session profile info the viewer can set for
// themselves — currently just an avatar. Same X-Session-Id used by
// UserVideoState/MarketplaceLink; no login required.
model SessionProfile {
  id          String   @id @default(cuid())
  sessionId   String   @unique
  // Local disk filename OR a full IMAGES_POINT (ImageKit) URL — see
  // routes/profile.ts, which resolves either the same way
  // routes/videos.ts resolves Video.filename/posterFilename.
  avatar      String?
  // Freeform display name the viewer can set for themselves — shown
  // next to their avatar wherever it appears (comments composer,
  // checkout). Purely cosmetic; never used for auth or as a lookup key.
  displayName String?
  updatedAt   DateTime @updatedAt
}

// Links an anonymous browser session (the same X-Session-Id used by
// UserVideoState) to an account on the external marketplace (reached
// via the MARKETPLACE_API env var). The marketplace's own auth token
// is stored server-side only — it is never sent to the frontend — so
// the in-video checkout flow can tell whether the current viewer is
// already logged in to the marketplace without re-authenticating on
// every checkout.
model MarketplaceLink {
  id                      String   @id @default(cuid())
  sessionId               String   @unique
  marketplaceToken        String
  // The marketplace's refresh token (extracted from its httpOnly
  // Set-Cookie on login — see backend/src/lib/marketplace.ts). Needed
  // because marketplaceToken (the access token) expires in ~1h; this
  // lets checkout silently refresh it instead of asking the viewer to
  // log in again every time they come back to shop.
  marketplaceRefreshToken String
  marketplaceUserId       String
  linkedAt                DateTime @default(now())
}

// A locally-recorded order, written once checkout actually succeeds —
// this is what GET /api/marketplace/orders reads to show a viewer's
// purchase history on their profile page (there is no local record of
// a purchase anywhere else; the external marketplace is authoritative
// for 'marketplace' orders, but never hands this app a history endpoint).
//
// `source` distinguishes the two checkout paths (see routes/marketplace.ts):
//  - "admin"       — items came from this app's own Product catalog
//    (the local phash-fallback search, with no marketplace seller).
//    There is no external account to check out through, so this app
//    fulfills the order directly and records the payment details the
//    buyer confirmed.
//  - "marketplace" — items came from the real external marketplace
//    (each has a sellerId). The marketplace itself creates the
//    authoritative order; this row is this app's own copy of it, plus
//    the seller's contact info so the buyer can arrange payment/pickup
//    (the marketplace has no online payment gateway — see README).
model Order {
  id                     String   @id @default(cuid())
  sessionId              String
  source                 String
  status                 String   @default("PENDING")
  sellerId               String?
  sellerName             String?
  sellerContact          String?
  marketplaceOrderId     String?
  marketplaceOrderNumber String?
  deliveryName           String
  deliveryPhone          String
  deliveryAddress        String
  paymentMethod          String?
  paymentLast4           String?
  createdAt              DateTime @default(now())
  items                  OrderItem[]

  @@index([sessionId])
  @@index([createdAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  name      String
  image     String?
  price     String
  quantity  Int

  @@index([orderId])
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Video {
  id             String   @id @default(cuid())
  title          String
  description    String   @default("")
  filename       String
  posterFilename String?
  mimeType       String
  size           Int
  duration       Float?
  likes          Int      @default(0)
  views          Int      @default(0)
  comments       Int      @default(0)
  // Times the share action was used (Web Share sheet or copy-link —
  // see POST /:id/share in routes/videos.ts). Unlike likes/saves this
  // has no per-session dedupe: sharing the same video twice is a
  // perfectly normal thing to do, it's a raw activity counter, not a
  // vote.
  shares         Int      @default(0)
  // Parsed from title+description at upload/edit time (see
  // lib/hashtags.ts) — a native Postgres text array rather than a
  // separate Hashtag model + join table, since all this needs is
  // "does this video have tag X" (`has`/`hasSome` filters) and a
  // simple unnest+count for trending (routes/videos.ts), neither of
  // which benefits from a full relational model.
  hashtags       String[] @default([])
  createdAt      DateTime @default(now())

  // The X-Session-Id that uploaded this video (see routes/videos.ts).
  // Nullable so pre-existing rows (uploaded before this column existed)
  // still read fine — they just have no discoverable uploader.
  uploaderSessionId String?

  commentList    Comment[]
  states         UserVideoState[]
  reportList     Report[]
  notifications  Notification[]

  @@index([createdAt])
  @@index([uploaderSessionId])
}

// A top-level comment or a reply (see parentId). Replies are flattened
// to exactly one level deep — replying to a reply attaches to its
// parent's own thread, matching the TikTok/Instagram convention,
// rather than allowing infinitely deep nesting (see routes/videos.ts's
// POST /:id/comments for where that flattening happens).
model Comment {
  id        String    @id @default(cuid())
  videoId   String
  video     Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)
  author    String    @default("Guest")
  text      String
  // Nullable — comments posted before this field existed have no
  // recorded author session, so "who to notify on reply" and
  // "flatten nested replies" both degrade gracefully to "unknown" for
  // those old rows rather than erroring.
  sessionId String?
  parentId  String?
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")
  createdAt DateTime  @default(now())

  @@index([videoId])
  @@index([parentId])
}

// Per-browser-session like/favorite/save state, keyed by an anonymous
// session id the frontend generates and stores in localStorage.
// This avoids requiring a login system while still persisting state.
model UserVideoState {
  id        String  @id @default(cuid())
  sessionId String
  videoId   String
  video     Video   @relation(fields: [videoId], references: [id], onDelete: Cascade)
  liked     Boolean @default(false)
  favorited Boolean @default(false)
  saved     Boolean @default(false)

  @@unique([sessionId, videoId])
  @@index([videoId])
}

// Product catalog used by visual search. `phash` is a 64-bit perceptual
// hash (as hex) computed once at seed/creation time and compared against
// the hash of the user's cropped selection using Hamming distance.
model Product {
  id            String @id @default(cuid())
  name          String
  price         String
  category      String
  imageFilename String
  phash         String
}

// A viewer's flag on a video, for the admin moderation queue (GET
// /api/admin/reports). One row per (video, session) — a session can
// flag a given video only once (see the unique constraint), which
// keeps a single anonymous session from padding a video's report
// count, without requiring real accounts to report abuse.
model Report {
  id        String   @id @default(cuid())
  videoId   String
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  sessionId String
  reason    String
  createdAt DateTime @default(now())

  @@unique([videoId, sessionId])
  @@index([videoId])
}

// A follow relationship between two sessions (see accounts.ts's
// POST /:handle/follow). Kept as plain sessionId pairs, the same
// pattern as Report/UserVideoState/MarketplaceLink above, rather than
// requiring a real User — following a creator shouldn't need an
// account any more than liking a video does. followerSessionId is the
// viewer; followingSessionId is whichever session holds the handle
// being followed (a handle always belongs to exactly one session —
// see SessionProfile.handle).
model Follow {
  id                 String   @id @default(cuid())
  followerSessionId  String
  followingSessionId String
  createdAt          DateTime @default(now())

  @@unique([followerSessionId, followingSessionId])
  @@index([followingSessionId])
  @@index([followerSessionId])
}

// In-app notification center (Cluster 4.4 — deliberately just the
// in-app list, not push/email/SMS, which need separate delivery
// infra). Two triggers for v1: a new follower (created in
// accounts.ts's POST /:handle/follow) and a comment on your video
// (created in videos.ts's POST /:id/comments) — the two payoffs of
// the Follow and comment features already built. Sessionid-keyed like
// everything else here; actorSessionId is resolved to a handle/avatar
// at read time (routes/notifications.ts) rather than snapshotted, so
// it stays correct if the actor later changes their display name.
model Notification {
  id                 String    @id @default(cuid())
  recipientSessionId String
  type               String // 'follow' | 'comment'
  actorSessionId     String
  videoId            String?
  video              Video?    @relation(fields: [videoId], references: [id], onDelete: SetNull)
  commentText        String?
  read               Boolean   @default(false)
  createdAt          DateTime  @default(now())

  @@index([recipientSessionId, createdAt])
}

// Admin accounts for the /admin dashboard. This app has no public user
// accounts — regular visitors interact anonymously via a per-browser
// session id (see UserVideoState). Only admins log in.
model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

// A real, persistent account a viewer/creator can sign up for so their
// handle and uploads survive clearing browser storage or switching
// devices — see routes/account.ts. Deliberately thin: identity for
// everyday actions (likes, uploads, comments) still flows entirely
// through X-Session-Id/SessionProfile exactly as before. Signing up
// or logging in just tells the caller which SessionProfile.sessionId
// is "canonical" for this email, via SessionProfile.userId below, so
// the frontend can adopt it as its own X-Session-Id afterwards and
// regain access to that identity's videos/handle from any device.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  profile      SessionProfile?
  resetTokens  PasswordResetToken[]
}

// Forgot-password flow (see routes/account.ts). Stores a HASH of the
// token, never the raw value — the raw token only ever exists in the
// emailed link, exactly like a session cookie or password itself
// would be handled. `usedAt` makes a token single-use even within its
// expiry window, so a reset link found in an old email (or intercepted
// once) can't be replayed.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Per anonymous-browser-session profile info the viewer can set for
// themselves — currently just an avatar. Same X-Session-Id used by
// UserVideoState/MarketplaceLink; no login required.
model SessionProfile {
  id          String   @id @default(cuid())
  sessionId   String   @unique
  // Local disk filename OR a full IMAGES_POINT (ImageKit) URL — see
  // routes/profile.ts, which resolves either the same way
  // routes/videos.ts resolves Video.filename/posterFilename.
  avatar      String?
  // Freeform display name the viewer can set for themselves — shown
  // next to their avatar wherever it appears (comments composer,
  // checkout). Purely cosmetic; never used for auth or as a lookup key.
  displayName String?
  // Public, unique, URL-safe slug (e.g. "rye-uploads") that makes this
  // otherwise-anonymous session discoverable at /u/:handle. Auto-
  // generated the first time a session needs one (first video upload,
  // or first visit to the account-discovery routes) — see
  // routes/profile.ts's ensureHandle() — and editable afterwards from
  // Settings. Nullable because most sessions never upload and so never
  // need one.
  handle      String?  @unique
  // Short freeform bio shown on the public /u/:handle profile page.
  bio         String?
  // Set once this session has signed up/logged in for a real account
  // (see routes/account.ts) — the User this profile (and everything
  // tied to this sessionId: uploads, likes, handle) now belongs to.
  // Nullable/unique: most sessions stay anonymous forever, and each
  // User has exactly one canonical SessionProfile.
  userId      String?  @unique
  user        User?    @relation(fields: [userId], references: [id])
  updatedAt   DateTime @updatedAt
}

// Links an anonymous browser session (the same X-Session-Id used by
// UserVideoState) to an account on the external marketplace (reached
// via the MARKETPLACE_API env var). The marketplace's own auth token
// is stored server-side only — it is never sent to the frontend — so
// the in-video checkout flow can tell whether the current viewer is
// already logged in to the marketplace without re-authenticating on
// every checkout.
model MarketplaceLink {
  id                      String   @id @default(cuid())
  sessionId               String   @unique
  marketplaceToken        String
  // The marketplace's refresh token (extracted from its httpOnly
  // Set-Cookie on login — see backend/src/lib/marketplace.ts). Needed
  // because marketplaceToken (the access token) expires in ~1h; this
  // lets checkout silently refresh it instead of asking the viewer to
  // log in again every time they come back to shop.
  marketplaceRefreshToken String
  marketplaceUserId       String
  linkedAt                DateTime @default(now())
}

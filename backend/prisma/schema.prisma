generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Video {
  id             String   @id @default(cuid())
  title          String
  description    String   @default("")
  filename       String
  posterFilename String?
  mimeType       String
  size           Int
  duration       Float?
  likes          Int      @default(0)
  views          Int      @default(0)
  comments       Int      @default(0)
  // Times the share action was used (Web Share sheet or copy-link —
  // see POST /:id/share in routes/videos.ts). Unlike likes/saves this
  // has no per-session dedupe: sharing the same video twice is a
  // perfectly normal thing to do, it's a raw activity counter, not a
  // vote.
  shares         Int      @default(0)
  // Parsed from title+description at upload/edit time (see
  // lib/hashtags.ts) — a native Postgres text array rather than a
  // separate Hashtag model + join table, since all this needs is
  // "does this video have tag X" (`has`/`hasSome` filters) and a
  // simple unnest+count for trending (routes/videos.ts), neither of
  // which benefits from a full relational model.
  hashtags       String[] @default([])
  createdAt      DateTime @default(now())

  // The X-Session-Id that uploaded this video (see routes/videos.ts).
  // Nullable so pre-existing rows (uploaded before this column existed)
  // still read fine — they just have no discoverable uploader.
  uploaderSessionId String?
  // Client-generated idempotency key for the upload that created this video.
  uploadKey         String? @unique

  // Shoppable moments: products pinned to this video (see VideoProduct).
  products          VideoProduct[]
  clicks            Click[]
  savedItems        SavedItem[]
  dailyStats        VideoDailyStat[]

  // Optional admin-managed location tag (see Location below).
  locationId     String?
  location       Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  commentList    Comment[]
  states         UserVideoState[]
  reportList     Report[]
  notifications  Notification[]

  @@index([createdAt])
  @@index([uploaderSessionId])
  @@index([locationId])
}

// A top-level comment or a reply (see parentId). Replies are flattened
// to exactly one level deep — replying to a reply attaches to its
// parent's own thread, matching the TikTok/Instagram convention,
// rather than allowing infinitely deep nesting (see routes/videos.ts's
// POST /:id/comments for where that flattening happens).
model Comment {
  id        String    @id @default(cuid())
  videoId   String
  video     Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)
  author    String    @default("Guest")
  text      String
  // Nullable — comments posted before this field existed have no
  // recorded author session, so "who to notify on reply" and
  // "flatten nested replies" both degrade gracefully to "unknown" for
  // those old rows rather than erroring.
  sessionId String?
  parentId  String?
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")
  likes       Int           @default(0)
  likeRecords CommentLike[]
  createdAt DateTime  @default(now())

  @@index([videoId])
  @@index([parentId])
}

// One (comment, session) pair per like — same toggle-by-uniqueness
// pattern as Follow/Report above, kept as its own tiny table rather
// than reusing UserVideoState, since a comment-like is a single
// boolean (no favorite/save equivalent) and doesn't need that model's
// other two fields.
model CommentLike {
  id        String   @id @default(cuid())
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  sessionId String
  createdAt DateTime @default(now())

  @@unique([commentId, sessionId])
  @@index([commentId])
}

// Per-browser-session like/favorite/save state, keyed by an anonymous
// session id the frontend generates and stores in localStorage.
// This avoids requiring a login system while still persisting state.
model UserVideoState {
  id        String  @id @default(cuid())
  sessionId String
  videoId   String
  video     Video   @relation(fields: [videoId], references: [id], onDelete: Cascade)
  liked     Boolean @default(false)
  favorited Boolean @default(false)
  saved     Boolean @default(false)
  // Set the first time this session watches the video (see POST /api/videos/:id/view).
  viewedAt  DateTime?

  @@unique([sessionId, videoId])
  @@index([videoId])
}

// Product catalog used by visual search. `phash` is a 64-bit perceptual
// hash (as hex) computed once at seed/creation time and compared against
// the hash of the user's cropped selection using Hamming distance.
model Product {
  id            String @id @default(cuid())
  name          String
  price         String
  category      String
  imageFilename String
  phash         String
}

// A viewer's flag on a video, for the admin moderation queue (GET
// /api/admin/reports). One row per (video, session) — a session can
// flag a given video only once (see the unique constraint), which
// keeps a single anonymous session from padding a video's report
// count, without requiring real accounts to report abuse.
model Report {
  id        String   @id @default(cuid())
  videoId   String
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  sessionId String
  reason    String
  createdAt DateTime @default(now())

  @@unique([videoId, sessionId])
  @@index([videoId])
}

// A follow relationship between two sessions (see accounts.ts's
// POST /:handle/follow). Kept as plain sessionId pairs, the same
// pattern as Report/UserVideoState/MarketplaceLink above, rather than
// requiring a real User — following a creator shouldn't need an
// account any more than liking a video does. followerSessionId is the
// viewer; followingSessionId is whichever session holds the handle
// being followed (a handle always belongs to exactly one session —
// see SessionProfile.handle).
model Follow {
  id                 String   @id @default(cuid())
  followerSessionId  String
  followingSessionId String
  createdAt          DateTime @default(now())

  @@unique([followerSessionId, followingSessionId])
  @@index([followingSessionId])
  @@index([followerSessionId])
}

// In-app notification center (Cluster 4.4 — deliberately just the
// in-app list, not push/email/SMS, which need separate delivery
// infra). Two triggers for v1: a new follower (created in
// accounts.ts's POST /:handle/follow) and a comment on your video
// (created in videos.ts's POST /:id/comments) — the two payoffs of
// the Follow and comment features already built. Sessionid-keyed like
// everything else here; actorSessionId is resolved to a handle/avatar
// at read time (routes/notifications.ts) rather than snapshotted, so
// it stays correct if the actor later changes their display name.
model Notification {
  id                 String    @id @default(cuid())
  recipientSessionId String
  type               String // 'follow' | 'comment'
  actorSessionId     String
  videoId            String?
  video              Video?    @relation(fields: [videoId], references: [id], onDelete: SetNull)
  commentText        String?
  read               Boolean   @default(false)
  createdAt          DateTime  @default(now())

  @@index([recipientSessionId, createdAt])
}

// Admin accounts for the /const/admin dashboard. Regular visitors interact
// via a per-browser session id / User account (see below); only admins log
// in here.
//
// Exactly one admin is PRIMARY: the first person to register. The primary
// admin has every permission implicitly and is the only one who can create,
// edit, disable or delete other admins. Everyone else is SECONDARY and can
// only do what `permissions` lists ("resource.action", e.g. "videos.delete"
// — see src/lib/permissions.ts for the catalogue).
enum AdminRole {
  PRIMARY
  SECONDARY
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String    @default("")
  role         AdminRole @default(SECONDARY)
  permissions  String[]  @default([])
  disabled     Boolean   @default(false)
  // The admin who created this account (null for the primary).
  createdById  String?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
}

// Append-only trail of what admins did, shown to the primary admin.
model AuditLog {
  id         String   @id @default(cuid())
  adminId    String?
  adminEmail String
  action     String // e.g. "video.delete"
  targetType String
  targetId   String?
  detail     String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([adminId])
}

// Admin-managed list of places. A location can be attached to a video
// (content) and to a user's profile; deleting a location just clears those
// references.
model Location {
  id        String           @id @default(cuid())
  name      String           @unique
  country   String           @default("")
  city      String           @default("")
  createdAt DateTime         @default(now())
  videos    Video[]
  profiles  SessionProfile[]
}

// A real, persistent account a viewer/creator can sign up for so their
// handle and uploads survive clearing browser storage or switching
// devices — see routes/account.ts. Deliberately thin: identity for
// everyday actions (likes, uploads, comments) still flows entirely
// through X-Session-Id/SessionProfile exactly as before. Signing up
// or logging in just tells the caller which SessionProfile.sessionId
// is "canonical" for this email, via SessionProfile.userId below, so
// the frontend can adopt it as its own X-Session-Id afterwards and
// regain access to that identity's videos/handle from any device.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  // Set by an admin to block this account (login + every write) without
  // deleting it. Null = active.
  suspendedAt  DateTime?

  profile      SessionProfile?
  resetTokens  PasswordResetToken[]
}

// Forgot-password flow (see routes/account.ts). Stores a HASH of the
// token, never the raw value — the raw token only ever exists in the
// emailed link, exactly like a session cookie or password itself
// would be handled. `usedAt` makes a token single-use even within its
// expiry window, so a reset link found in an old email (or intercepted
// once) can't be replayed.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Per anonymous-browser-session profile info the viewer can set for
// themselves — currently just an avatar. Same X-Session-Id used by
// UserVideoState/MarketplaceLink; no login required.
model SessionProfile {
  id          String   @id @default(cuid())
  sessionId   String   @unique
  // Local disk filename OR a full R2 public URL (or a legacy ImageKit URL until migrated) — see
  // routes/profile.ts, which resolves either the same way
  // routes/videos.ts resolves Video.filename/posterFilename.
  avatar      String?
  // Freeform display name the viewer can set for themselves — shown
  // next to their avatar wherever it appears (comments composer,
  // upload). Purely cosmetic; never used for auth or as a lookup key.
  displayName String?
  // Public, unique, URL-safe slug (e.g. "rye-uploads") that makes this
  // otherwise-anonymous session discoverable at /u/:handle. Auto-
  // generated the first time a session needs one (first video upload,
  // or first visit to the account-discovery routes) — see
  // routes/profile.ts's ensureHandle() — and editable afterwards from
  // Settings. Nullable because most sessions never upload and so never
  // need one.
  handle      String?  @unique
  // Short freeform bio shown on the public /u/:handle profile page.
  bio         String?
  // Set once this session has signed up/logged in for a real account
  // (see routes/account.ts) — the User this profile (and everything
  // tied to this sessionId: uploads, likes, handle) now belongs to.
  // Nullable/unique: most sessions stay anonymous forever, and each
  // User has exactly one canonical SessionProfile.
  userId      String?  @unique
  user        User?    @relation(fields: [userId], references: [id])
  // Optional admin-assigned location (see Location).
  locationId  String?
  location    Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  updatedAt   DateTime @updatedAt
}

// DEPRECATED — no longer read or written by any code.
//
// This used to link an anonymous browser session to a piitrade.com
// account so the in-video cart could place orders. piitrade.com is now
// a classifieds marketplace (no cart, no orders), so Piitrade Videos
// simply sends viewers to the listing on piitrade.com instead and
// stores no marketplace credentials at all.
//
// The table is deliberately left in place so this change deploys
// without deleting any data. Existing rows still hold marketplace
// tokens, so it is worth dropping in a follow-up migration:
//   DROP TABLE "MarketplaceLink";
// (and removing this model) once you are happy nothing needs them.
model MarketplaceLink {
  id                      String   @id @default(cuid())
  sessionId               String   @unique
  marketplaceToken        String
  // The marketplace's refresh token (extracted from its httpOnly
  // Set-Cookie on login — see backend/src/lib/marketplace.ts). Needed
  // because marketplaceToken (the access token) expires in ~1h; this
  // lets checkout silently refresh it instead of asking the viewer to
  // log in again every time they come back to shop.
  marketplaceRefreshToken String
  marketplaceUserId       String
  linkedAt                DateTime @default(now())
}


// ---------------------------------------------------------------------------
// Shops, attribution and the creator ledger (docs/GLOBAL_POSITIONING.md)
// ---------------------------------------------------------------------------

// A shop/marketplace that videos may link to. Outbound product links are only
// allowed on a registered, active site's host, and a site reports sales back via
// a postback signed with its own `postbackSecret`.
model Site {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  // Shop origin, e.g. https://piitrade.com — product links must be on this host.
  baseUrl        String
  // Listing API base used by "Test connection" (GET {apiBase}/api/listings?...). Optional.
  apiBase        String   @default("")
  apiType        String   @default("piitrade")
  country        String   @default("")
  currency       String   @default("")
  // % of each attributed order value owed to the video's creator.
  commissionPct  Float    @default(0)
  postbackSecret String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  products    VideoProduct[]
  clicks      Click[]
  conversions Conversion[]
  savedItems  SavedItem[]
  dailyStats  SiteDailyStat[]
}

// One product pinned to a video, optionally only during [startMs, endMs] and at a
// hotspot (x, y are 0..1 fractions of the frame).
model VideoProduct {
  id        String   @id @default(cuid())
  videoId   String
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  url       String
  // url with tracking params / trailing slash stripped — what the embed widget matches on.
  urlKey    String
  title     String   @default("")
  startMs   Int      @default(0)
  endMs     Int?
  x         Float?
  y         Float?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([videoId])
  @@index([urlKey])
}

// A logged outbound tap. `token` travels to the shop as ?pv_click= and comes back in the postback.
model Click {
  id               String   @id @default(cuid())
  token            String   @unique
  // Kept (SET NULL) if the video is later deleted — the ledger must outlive it.
  videoId          String?
  video            Video?   @relation(fields: [videoId], references: [id], onDelete: SetNull)
  siteId           String
  site             Site     @relation(fields: [siteId], references: [id], onDelete: Restrict)
  productId        String?
  creatorSessionId String?
  // Salted hashes only — never the raw session id or IP.
  viewerHash       String?
  ipHash           String?
  url              String
  createdAt        DateTime @default(now())

  conversions Conversion[]

  @@index([videoId])
  @@index([siteId, createdAt])
  @@index([creatorSessionId])
}

// A sale the shop reported for a click. Money is stored in minor units (cents).
model Conversion {
  id              String   @id @default(cuid())
  clickId         String
  click           Click    @relation(fields: [clickId], references: [id], onDelete: Restrict)
  siteId          String
  site            Site     @relation(fields: [siteId], references: [id], onDelete: Restrict)
  externalOrderId String
  amountMinor     BigInt
  currency        String
  createdAt       DateTime @default(now())

  payout PayoutEntry?

  // Replaying the same postback must not double-count.
  @@unique([siteId, externalOrderId])
}

// What is owed to a creator for one conversion. status: pending → approved → paid, or reversed.
model PayoutEntry {
  id               String     @id @default(cuid())
  conversionId     String     @unique
  conversion       Conversion @relation(fields: [conversionId], references: [id], onDelete: Restrict)
  creatorSessionId String
  amountMinor      BigInt
  currency         String
  status           String     @default("pending")
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @default(now()) @updatedAt

  @@index([creatorSessionId, status])
}

// A product a viewer saved from a video to look at later ("Saved items"): tapping a product tag saves
// it without leaving the video. It's a snapshot (url/title), so it survives the creator re-pinning
// products, and the video link is cleared (SET NULL) rather than the item deleted if the video goes.
model SavedItem {
  id        String   @id @default(cuid())
  sessionId String
  videoId   String?
  video     Video?   @relation(fields: [videoId], references: [id], onDelete: SetNull)
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  url       String
  urlKey    String
  title     String   @default("")
  createdAt DateTime @default(now())

  // Saving the same product twice is one item.
  @@unique([sessionId, urlKey])
  @@index([sessionId, createdAt])
  @@index([siteId, createdAt])
}

// ---------------------------------------------------------------------------
// Viewing guardrail: do product tags hurt watch time? (docs/GUARDRAIL.md)
// ---------------------------------------------------------------------------

// Per video, per UTC day, per cohort — sums only, no per-viewer rows. cohort is
//   exposed  : viewer saw this tagged video's product tags
//   holdout  : viewer was randomly (deterministically, by hashed session) NOT shown tags
//   untagged : video has no products (baseline, not a controlled comparison)
// sumFrac / sumFracSq are sums of each session's watch-through (0..1) and its square, which is
// everything needed for a mean, variance and significance test without storing every session.
model VideoDailyStat {
  id          String   @id @default(cuid())
  videoId     String
  video       Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  day         DateTime @db.Date
  cohort      String
  sessions    Int      @default(0)
  completions Int      @default(0)
  sumWatchMs  BigInt   @default(0)
  sumFrac     Float    @default(0)
  sumFracSq   Float    @default(0)

  @@unique([videoId, day, cohort])
  @@index([day, cohort])
}

// Product tags shown to viewers, per shop per day (the top of the partner funnel:
// shown → saved → clicked → sold).
model SiteDailyStat {
  id          String   @id @default(cuid())
  siteId      String
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  day         DateTime @db.Date
  impressions Int      @default(0)

  @@unique([siteId, day])
}

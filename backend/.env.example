DATABASE_URL=postgresql://user:pass@localhost:5432/piitrade
ALLOWED_ORIGIN=https://piitrade.com
JWT_SECRET=change-me

# --- Cloudflare R2 media storage (videos, posters, avatars) ---
# Leave all five unset to keep files on local disk (dev only — container disks are ephemeral).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=piitrade-media
# Public base URL of the bucket: a custom domain (recommended) or the r2.dev URL. No trailing slash.
R2_PUBLIC_URL=https://media.example.com
# R2_ENDPOINT=https://<account>.eu.r2.cloudflarestorage.com   # only for EU-jurisdiction buckets

DATABASE_URL=postgresql://user:pass@localhost:5432/piitrade
UPLOAD_DIR=./uploads
# Leave unset to allow every origin. When set, only these (comma separated) plus https://videos.piitrade.com, https://yotweek.com,
# https://www.yotweek.com, https://piitrade.com, https://www.piitrade.com and the Android app's https://localhost are always allowed.
ALLOWED_ORIGIN=https://videos.piitrade.com
JWT_SECRET=change-me

# Admin dashboard: /const/admin. The first person to register there becomes the
# PRIMARY admin (full control; creates secondary admins and chooses their
# permissions). Optional but recommended on a public deployment: if set, this
# code is required for that first registration so nobody else can claim it.
ADMIN_SETUP_CODE=

# --- Cloudflare R2 media storage (videos, posters, avatars) ---
# Leave all five unset to keep files on local disk (dev only — container disks are ephemeral).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=piitrade-media
# Public base URL of the bucket: a custom domain (recommended) or the r2.dev URL. No trailing slash.
R2_PUBLIC_URL=https://media.example.com
# R2_ENDPOINT=https://<account>.eu.r2.cloudflarestorage.com   # only for EU-jurisdiction buckets

# --- Attribution, embeds and shops (docs/ATTRIBUTION.md, docs/EMBEDS.md) ---
# Public origin of this deployment, used in embed/oEmbed/permalink URLs. Falls back to the request host.
PUBLIC_WEB_URL=
# Who may put the /embed player in an iframe: "*" (default) or a space-separated list of origins.
EMBED_FRAME_ANCESTORS=*
# Salt for the one-way hashes stored with clicks (never the raw session id or IP). Defaults to JWT_SECRET.
ATTRIBUTION_SALT=
# Commission % given to the default "Piitrade" shop the first time the server starts (change it in Admin → Shops).
DEFAULT_COMMISSION_PCT=0
# Number of reverse proxies in front of the backend (1 = nginx). 0 if exposed directly.
TRUST_PROXY=1

# Viewing guardrail (docs/GUARDRAIL.md): % of viewers randomly shown NO product tags so watch time can be
# compared fairly. 0 turns it off.
CHIP_HOLDOUT_PCT=5

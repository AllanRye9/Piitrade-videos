# Copy this file to `.env` in the project root before deploying publicly.
# docker-compose automatically reads a `.env` file in this directory.

# Secret used to sign admin JWTs. Generate one with:
#   openssl rand -base64 32
JWT_SECRET=change-me-to-a-long-random-string

# Optional. Once one admin account exists, anyone registering a new
# admin account must supply this code. Leave blank only for local/dev use.
ADMIN_SETUP_CODE=

# --- In-video visual search: AI identify + marketplace lookup ---
# Both of these must be set for the AI+marketplace pipeline to be used;
# if either is blank, visual search falls back to the local
# perceptual-hash catalog match (see README "Visual search modes").

# Base URL of the image-identification service — NO trailing slash and
# NO /identify suffix (backend/src/lib/aiSearch.ts appends /identify
# itself). This is the real, live Piitrade image-identification
# Cloudflare Worker (Workers AI: Llama 4 Scout) — the same one used
# elsewhere for AI-powered listing generation.
AI_SEARCH=https://apkit.allan-rye-999.workers.dev
# Optional bearer token the backend sends to AI_SEARCH. Leave blank —
# the live worker above does not check for one today.
AI_SEARCH_API_KEY=

# Base URL of the Piitrade CLASSIFIEDS marketplace's BACKEND API — NOT
# the piitrade.com frontend URL (confirmed directly: piitrade.com/listings
# returns the rendered HTML page, not JSON; the website itself loads
# listing images from this separate backend host). It is only used to
# SEARCH listings; piitrade.com is a classifieds site, so there is no
# cart/checkout/login here — viewers are sent to the listing on
# piitrade.com. Verify the current exact backend URL before deploying —
# Railway hostnames can change on redeploy (open piitrade.com, copy the
# host from any listing image URL) — this is the one observed while testing:
MARKETPLACE_API=https://backend-production-a662.up.railway.app
# Optional — sent as &country=<value> on every /api/listings search,
# e.g. .../api/listings?q=oil&country=UGANDA. Leave blank to search
# without a country filter.
MARKETPLACE_COUNTRY=UGANDA
# Optional — currency shown for a listing whose API record has none.
MARKETPLACE_DEFAULT_CURRENCY=UGX
# Public piitrade.com website URL that listing links and "See all on
# Piitrade" buttons point at (the website, not the API host above).
PIITRADE_SITE_URL=https://piitrade.com

# --- Cloudflare R2 media storage (optional; local disk is used if unset) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
# R2_ENDPOINT=   # optional override for EU-jurisdiction buckets

# --- worker/ service (hosts the identification AI) ---
# Required by worker/worker.js: it calls Anthropic's API to identify
# the cropped selection. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# --- Video upload / processing (all optional; defaults shown) ---
# Where uploaded videos, posters and product images are stored. docker-compose mounts a volume at /app/uploads.
# UPLOAD_DIR=/app/uploads
# Longest side of the stored video in pixels. Bigger sources (4K) are scaled down, never up — the main
# reason large uploads encode quickly.
# TRANSCODE_MAX_LONG_EDGE=1920
# One encode is killed after this long (ms) and the uploader is told it took too long.
# TRANSCODE_TIMEOUT_MS=720000
# Encodes that run at once; extra uploads wait their turn instead of starving each other (and the server of memory).
# TRANSCODE_CONCURRENCY=2
# How long (ms) one upload may take to arrive over a slow connection.
# UPLOAD_REQUEST_TIMEOUT_MS=1800000

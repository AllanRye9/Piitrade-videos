# Copy this file to `.env` in the project root before deploying publicly.
# docker-compose automatically reads a `.env` file in this directory.

# Secret used to sign admin JWTs. Generate one with:
#   openssl rand -base64 32
JWT_SECRET=change-me-to-a-long-random-string

# Optional. Once one admin account exists, anyone registering a new
# admin account must supply this code. Leave blank only for local/dev use.
ADMIN_SETUP_CODE=

# --- In-video visual search: AI identify + marketplace lookup ---
# Both of these must be set for the AI+marketplace pipeline to be used;
# if either is blank, visual search falls back to the local
# perceptual-hash catalog match (see README "Visual search modes").

# Base URL of the image-identification service — NO trailing slash and
# NO /identify suffix (backend/src/lib/aiSearch.ts appends /identify
# itself). This is the real, live Piitrade image-identification
# Cloudflare Worker (Workers AI: Llama 4 Scout) — the same one used
# elsewhere for AI-powered listing generation.
AI_SEARCH=https://apkit.allan-rye-999.workers.dev
# Optional bearer token the backend sends to AI_SEARCH. Leave blank —
# the live worker above does not check for one today.
AI_SEARCH_API_KEY=

# Base URL of the real Piitrade marketplace's BACKEND API — NOT the
# piitrade.com frontend URL (confirmed directly: piitrade.com/listings
# returns the rendered HTML page, not JSON; the frontend itself loads
# listing images from this separate backend host). Verify the current
# exact backend URL before deploying — Railway hostnames can change on
# redeploy — this is the one observed while testing:
MARKETPLACE_API=https://backend-production-a662.up.railway.app
# Optional — sent as &country=<value> on every /api/listings search,
# e.g. .../api/listings?q=oil&country=UGANDA. One of UAE, UGANDA,
# KENYA, CHINA. Leave blank to search without a country filter.
MARKETPLACE_COUNTRY=UGANDA

# --- ImageKit-backed storage (optional) ---
# Both are optional and independent. When unset, videos/posters and
# avatars are stored on local disk (uploads/) exactly as before — see
# backend/src/lib/imagekit.ts. Set either or both to move that asset
# type onto ImageKit's CDN instead.

# ImageKit URL endpoint used for uploaded videos + their poster frames.
# e.g. https://ik.imagekit.io/your_imagekit_id
VIDEO_STORE=
# ImageKit URL endpoint used for profile/avatar images. Can be the
# same ImageKit account as VIDEO_STORE (just a different folder) or a
# different one entirely.
IMAGES_POINT=

# Shared ImageKit Upload API credentials, used for both stores above
# unless overridden per-store (see below). Get these from
# https://imagekit.io/dashboard/developer/api-keys
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
# Only needed if VIDEO_STORE / IMAGES_POINT are on *different* ImageKit
# accounts (not just different folders on the same account):
# VIDEO_STORE_PUBLIC_KEY=
# VIDEO_STORE_PRIVATE_KEY=
# IMAGES_POINT_PUBLIC_KEY=
# IMAGES_POINT_PRIVATE_KEY=

# --- worker/ service (hosts the identification AI) ---
# Required by worker/worker.js: it calls Anthropic's API to identify
# the cropped selection. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
